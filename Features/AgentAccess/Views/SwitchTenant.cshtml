@model Hub.Features.AgentAccess.Oauth.AgentAccessSwitchTenantViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex"/>
    <title>Connect @Model.ClientName</title>
    <link rel="stylesheet" href="~/consent.css" asp-append-version="true"/>
</head>
<body>
<div class="auth-wrapper">
    <div class="auth-card" id="agentAccessSwitchTenant">
        <h2>Connect @Model.ClientName</h2>
        <p class="auth-subtitle">
            You're signed in to <strong>@Model.CurrentTenantName</strong>, but @Model.ClientName is connecting to
            <strong>@Model.HubTenantName</strong>.
        </p>

        @if (Model.CanSwitch)
        {
            <p>Switch to @Model.HubTenantName to continue. Your Hub will switch to @Model.HubTenantName too.</p>
        }
        else
        {
            <p>Your account doesn't have access to @Model.HubTenantName, so it can't be connected here.</p>
        }

        @if (Model.Error is not null)
        {
            <p class="text-danger" role="alert">@Model.Error</p>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            @* OpenIddict reads a POST from the form body only, so the original request travels as hidden fields. *@
            @foreach (var parameter in Context.Request.HasFormContentType ? Context.Request.Form.AsEnumerable() : Context.Request.Query.AsEnumerable())
            {
                if (parameter.Key == "decision" || parameter.Key == "__RequestVerificationToken") { continue; }
                foreach (var value in parameter.Value)
                {
                    <input type="hidden" name="@parameter.Key" value="@value"/>
                }
            }
            <div class="d-flex gap-2">
                @if (Model.CanSwitch)
                {
                    <button type="submit" name="decision" value="switch" class="btn btn-primary">Switch to @Model.HubTenantName</button>
                }
                <button type="submit" name="decision" value="cancel" class="btn btn-outline-secondary">Cancel</button>
            </div>
        </form>
    </div>
</div>
</body>
</html>
