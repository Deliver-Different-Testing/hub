@model Hub.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home page";

    var contactId = Model.ContactId;
    var greetingString = Model.GreetingString;
    var userEmail = Model.UserEmail;
    var tenantCode = Model.TenantCode;

    var clientInternal = bool.TryParse(Model.ClientInternal, out var ci) && ci;
    var isCourier = bool.TryParse(User.FindFirst("IsCourier")?.Value, out var c) && c;
    var bulkUploadPermission = Model.BulkUploadPermission;

    var isUrgentAsureUser = !string.IsNullOrEmpty(userEmail) &&
                            !string.IsNullOrEmpty(tenantCode) &&
                            userEmail.Equals("asure@urgent.co.nz", StringComparison.OrdinalIgnoreCase) &&
                            tenantCode.Equals("urgent", StringComparison.OrdinalIgnoreCase);

    string AppUrl(string appName) =>
        Environment.GetEnvironmentVariable("TenantURL")!.Replace("app_name", appName);

    var bookingAppPath = isUrgentAsureUser ? "/#/asure" : "/#/login/";
    var bookingAppFullUrl = AppUrl("booking") + bookingAppPath;
}
<script>
    const ContactID = '@contactId';
    const GreetingString = '@greetingString';
</script>

<div id="urgent-hub">
    <div class="hub-header">
        @await Component.InvokeAsync("TenantLogo", new { cssClass = "logo", alt = "Deliver Different" })
        <h4>App Hub</h4>
    </div>

    <div class="app-grid">
        @if (isCourier)
        {
            @if (Model.ShowAfterHours)
            {
                <div class="app-card" onclick="window.open('@AppUrl("afterhours")')">
                    <div class="app-card-icon"><img class="icon-lg" src="~/images/icons/dispatch.svg" alt="After Hours" /></div>
                    <div class="app-card-title">After Hours</div>
                </div>
            }
            <div class="app-card" onclick="window.open('@AppUrl("courierportal")')">
                <div class="app-card-icon"><img class="icon-lg" src="~/images/icons/courier-portal.svg" alt="Courier Portal" /></div>
                <div class="app-card-title">Courier Portal</div>
            </div>
        }
        else if (!clientInternal)
        {
            <div class="app-card" onclick="window.open('@bookingAppFullUrl')">
                <div class="app-card-icon"><img src="~/images/icons/booking-page.svg" alt="Booking Page" /></div>
                <div class="app-card-title">Booking Page</div>
            </div>
            @if (bulkUploadPermission)
            {
                <div class="app-card" onclick="window.open('@(AppUrl("bulkimport") + "/#/login/")')">
                    <div class="app-card-icon"><img src="~/images/icons/bulk-import.svg" alt="Bulk Import" /></div>
                    <div class="app-card-title">Bulk Import</div>
                </div>
            }
            @if (!isUrgentAsureUser)
            {
                <div class="app-card" onclick="window.open('@(AppUrl("runviewer") + "/#/print")')">
                    <div class="app-card-icon"><img src="~/images/icons/print.svg" alt="Print" /></div>
                    <div class="app-card-title">Print</div>
                </div>
                <div class="app-card" onclick="window.open('@AppUrl("runviewer")')">
                    <div class="app-card-icon"><img class="icon-lg" src="~/images/icons/route-viewer.svg" alt="Route Viewer" /></div>
                    <div class="app-card-title">Route Viewer</div>
                </div>
            }
            <div class="app-card" onclick="window.open('@AppUrl("tracking")')">
                <div class="app-card-icon"><img src="~/images/icons/tracker.svg" alt="Tracker" /></div>
                <div class="app-card-title">Tracker</div>
            </div>
        }
        else
        {
            <div class="app-card" onclick="window.open('@AppUrl("accounts")')">
                <div class="app-card-icon"><img src="~/images/icons/accounts.svg" alt="Accounts" /></div>
                <div class="app-card-title">Accounts</div>
            </div>
            <div class="app-card" onclick="window.open('@AppUrl("adminmanager")')">
                <div class="app-card-icon"><img src="~/images/icons/admin-manager.svg" alt="Admin Manager" /></div>
                <div class="app-card-title">Admin Manager</div>
            </div>
            <div class="app-card" onclick="window.open('@bookingAppFullUrl')">
                <div class="app-card-icon"><img src="~/images/icons/booking-page.svg" alt="Booking Page" /></div>
                <div class="app-card-title">Booking Page</div>
            </div>
            <div class="app-card" onclick="window.open('@(AppUrl("bulkimport") + "/#/login/")')">
                <div class="app-card-icon"><img src="~/images/icons/bulk-import.svg" alt="Bulk Import" /></div>
                <div class="app-card-title">Bulk Import</div>
            </div>
            <div class="app-card" onclick="window.open('@AppUrl("clientmanager")')">
                <div class="app-card-icon"><img src="~/images/icons/client-manager.svg" alt="Client Manager" /></div>
                <div class="app-card-title">Client Manager</div>
            </div>
            <div class="app-card" onclick="window.open('@AppUrl("couriermanager")')">
                <div class="app-card-icon"><img class="icon-lg" src="~/images/icons/courier-manager.svg" alt="Courier Manager" /></div>
                <div class="app-card-title">Courier Manager</div>
            </div>
            <div class="app-card" onclick="window.open('@AppUrl("courierportal")')">
                <div class="app-card-icon"><img class="icon-lg" src="~/images/icons/courier-portal.svg" alt="Courier Portal" /></div>
                <div class="app-card-title">Courier Portal</div>
            </div>
            <div class="app-card" onclick="window.open('@AppUrl("despatch")')">
                <div class="app-card-icon"><img class="icon-lg" src="~/images/icons/dispatch.svg" alt="Dispatch" /></div>
                <div class="app-card-title">Dispatch</div>
            </div>
            <div class="app-card" onclick="window.open('@(AppUrl("runviewer") + "/#/print")')">
                <div class="app-card-icon"><img src="~/images/icons/print.svg" alt="Print" /></div>
                <div class="app-card-title">Print</div>
            </div>
            <div class="app-card" onclick="window.open('@AppUrl("runviewer")')">
                <div class="app-card-icon"><img class="icon-lg" src="~/images/icons/route-viewer.svg" alt="Route Viewer" /></div>
                <div class="app-card-title">Route Viewer</div>
            </div>
            <div class="app-card" onclick="window.open('@AppUrl("runbuilder")')">
                <div class="app-card-icon"><img class="icon-lg" src="~/images/icons/route-builder.svg" alt="Route Builder" /></div>
                <div class="app-card-title">Route Builder</div>
            </div>
            <div class="app-card" onclick="window.open('@AppUrl("tracking")')">
                <div class="app-card-icon"><img src="~/images/icons/tracker.svg" alt="Tracker" /></div>
                <div class="app-card-title">Tracker</div>
            </div>
            <div class="app-card" onclick="window.open('@(AppUrl("integrationmanager") + "/auth/entry")')">
                <div class="app-card-icon"><img src="~/images/icons/integration-hub.svg" alt="Integration Manager" /></div>
                <div class="app-card-title">Integration Manager</div>
            </div>
        }
    </div>
</div>
