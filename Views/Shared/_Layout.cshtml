@using Hub.Interfaces
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject ITenantService TenantService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Deliver DFRNT</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/dist/vendor.css"/>
    <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true"/>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg?v=6">
    <link rel="alternate icon" href="~/images/favicon.ico?11" type="image/x-icon">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-player/2.0.12/lottie-player.js"
            integrity="sha512-2nOSQ1o1ohJgCDWTrSe2tFG4CU8hurCGROpUKoopgPHT2mUWy1mgLed21mf2le8n9gZ2c3ujOHuiXlivAnYvTQ=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <meta http-equiv="refresh" content="300">
</head>
@{
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    var userIdClaim = User.FindFirst("UserID");
    var currentTenantIdClaim = User.FindFirst("CurrentTenantID");

    List<TenantViewModel>? tenants = null;
    int? currentTenantId = 0;
    if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
    {
        var tenantList = await TenantService.GetTenantsForUserAsync(userId);
        tenants = tenantList.Select(o => new TenantViewModel { Id = o.TenantId, Name = o.Name, Code = o.Code, CountryCode = o.CountryCode }).ToList();

        if (currentTenantIdClaim != null && int.TryParse(currentTenantIdClaim.Value, out var orgId))
        {
            currentTenantId = orgId;
        }
    }

    var hasTenants = tenants != null && tenants.Any();
    var currentTenantCode = User.FindFirst("TenantCode")?.Value ?? string.Empty;
    var currentTenantCountry = User.FindFirst("CountryCode")?.Value ?? string.Empty;

    var userEmail = User.Identity?.Name ?? string.Empty;
    var firstNameClaim = User.FindFirst("FirstName")?.Value?.Trim() ?? string.Empty;
    var surnameClaim = User.FindFirst("Surname")?.Value?.Trim() ?? string.Empty;
    var displayFullName = string.Join(' ', new[] { firstNameClaim, surnameClaim }
        .Where(p => !string.IsNullOrEmpty(p)));
    if (string.IsNullOrEmpty(displayFullName))
    {
        var nameParts = userEmail
            .Split('@')[0]
            .Split([' ', '.', '-', '_'], StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Length > 0 ? char.ToUpper(p[0]) + p[1..].ToLower() : p)
            .ToArray();
        displayFullName = string.Join(' ', nameParts);
    }
    var displayLabel = string.IsNullOrEmpty(displayFullName) ? userEmail : displayFullName;
}
<body id="@ViewBag.PageId" data-tenant-country="@currentTenantCountry" data-tenant-code="@currentTenantCode" data-has-tenants="@hasTenants.ToString().ToLower()">
<meta name="request-token" content="@requestToken" />
<header>
    <nav class="navbar navbar-expand-sm navbar-floating mb-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                @await Component.InvokeAsync("TenantLogo", new { cssClass = "logo", alt = "Deliver DFRNT" })
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1"></ul>
                <ul class="navbar-nav align-items-center">
                    @if (tenants != null && tenants.Any())
                    {
                        <li class="nav-item tenant-selector me-3">
                            <span class="tenant-label me-2">Organizations:</span>
                            <div class="dropdown">
                                <button class="btn btn-primary dropdown-toggle" type="button" id="tenantDropdown"
                                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    @(tenants.FirstOrDefault(t => t.Id == currentTenantId)?.Name ?? "Select Tenant")
                                    <span class="spinner-border spinner-border-sm d-none" role="status"
                                          aria-hidden="true"></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="tenantDropdown">
                                    @foreach (var tenant in tenants)
                                    {
                                        <a class="dropdown-item @(tenant.Id == currentTenantId ? "active" : string.Empty)"
                                           href="#" data-tenant-code="@tenant.Code"
                                           data-tenant-id="@tenant.Id">@tenant.Name</a>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-3">
                            <div class="profile-dropdown">
                                <div class="profile-icon-username">
                                    <span class="username">@displayLabel</span>
                                    <span class="material-symbols-outlined dropdown-arrow">expand_more</span>
                                </div>
                                <div class="profile-menu">
                                    <div class="profile-menu-header">
                                        <span class="material-symbols-outlined profile-menu-header-icon">account_circle</span>
                                        <span class="profile-menu-header-email" title="@userEmail">@userEmail</span>
                                    </div>
                                    <div class="profile-menu-divider"></div>
                                    <a href="@Url.Action("Settings", "Account")" class="profile-menu-item">
                                        <span class="material-symbols-outlined menu-icon">settings</span>
                                        Settings
                                    </a>
                                    <a href="@Url.Action("Logout", "Account")" class="profile-menu-item">
                                        <span class="material-symbols-outlined menu-icon">logout</span>
                                        Logout
                                    </a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container" style="width:85%; max-width:1500px; flex:1;">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="footer">
    <div class="container footer-row">
        <div class="footer-meta">&copy; @DateTime.Now.Year Deliver DFRNT</div>
    </div>
</footer>

<script src="~/dist/vendor.js"></script>
<script src="~/dist/layout.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
