@model LoginViewModel
@{
    ViewBag.Title = "Log in";
    ViewBag.PageId = "login";
    ViewBag.LoginFailedData = ViewBag.LoginFailed == true ? "true" : "false";
}

<div class="auth-wrapper" data-login-failed="@ViewBag.LoginFailedData">
    <div class="auth-card">
        <div class="auth-progress" id="loginProgress" role="progressbar" aria-label="Signing in" aria-hidden="true">
            <div class="auth-progress-bar"></div>
        </div>
        @* Two mascot variants, theme-toggled by CSS (no flash: the theme is
           resolved before paint). The dark variant knocks its baked-in white
           backing back to a translucent panel so it melts into the card instead
           of sitting in a white box. login.ts plays whichever is visible. *@
        <div class="text-center">
            <lottie-player class="auth-lottie auth-lottie-light" src="/images/Auto-mate-Ready%20state%20(2).json" background="transparent" speed="1" loop></lottie-player>
            <lottie-player class="auth-lottie auth-lottie-dark" src="/images/Auto-mate-Ready%20state%20(2)_dark.json" background="transparent" speed="1" loop></lottie-player>
        </div>
        <h2>Welcome back</h2>
        <p class="auth-subtitle">Sign in to your account</p>

        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewBag.ReturnUrl" method="post" class="needs-validation" novalidate id="loginForm">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "auth-form-error" })

            <div class="mb-3 form-floating">
                <input asp-for="Email" type="email" class="form-control" placeholder="you@company.com"
                       required autocomplete="username" />
                <label asp-for="Email">Email</label>
                <div class="invalid-feedback"></div>
            </div>

            <div class="mb-3 form-floating">
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password"
                       required autocomplete="current-password" />
                <label asp-for="Password">Password</label>
                <div class="invalid-feedback"></div>
            </div>

            <div class="mb-3 form-floating">
                <select name="IsCourierLogin" id="IsCourierLogin" class="form-select" required>
                    <option value="false" selected>Customer Login</option>
                    <option value="true">Courier Login</option>
                </select>
                <label for="IsCourierLogin">Login Type</label>
            </div>

            <div class="mb-4 text-center">
                <label class="remember-me">
                    <input class="form-check-input m-0" type="checkbox" name="RememberMe" value="true" />
                    <span>Remember me</span>
                </label>
            </div>

            <div class="mb-3 text-center">
                <button type="submit" id="loginButton" class="btn btn-primary">
                    <dfrnt-icon set="lucide" name="log-in" />
                    <span class="button-label">Log in</span>
                </button>
            </div>

            <div class="text-center">
                <a asp-action="ForgotPassword" asp-controller="Account">Forgot your password?</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/dist/login.css" asp-append-version="true" />
    <script src="~/dist/login.js" asp-append-version="true"></script>
}
