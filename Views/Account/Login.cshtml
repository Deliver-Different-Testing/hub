@model LoginViewModel
@{
    ViewBag.Title = "Log in";
    ViewBag.PageId = "login";
    ViewBag.LoginFailedData = ViewBag.LoginFailed == true ? "true" : "false";
}

<div class="auth-wrapper" data-login-failed="@ViewBag.LoginFailedData">
    <div class="auth-card">
        <div class="text-center">
            <lottie-player src="/images/Auto-mate-Ready%20state%20(2).json" background="transparent" speed="1" style="width: 200px; height: 200px; margin: 0 auto;" loop autoplay></lottie-player>
        </div>
        <h2>Welcome back</h2>
        <p class="auth-subtitle">Sign in to your account</p>

        <div class="auth-info-box">
            <div class="icon">
                <span class="material-symbols-outlined">location_on</span>
            </div>
            Login to our customer area
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewBag.ReturnUrl" method="post" class="needs-validation" novalidate id="loginForm">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" required type="email" placeholder="you@company.com" />
                <div class="invalid-feedback">
                    Please enter a valid email address.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" required placeholder="Enter your password" />
                <div class="invalid-feedback">
                    Please enter your password.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="IsCourierLogin" class="form-label">Login Type</label>
                <select asp-for="IsCourierLogin" class="form-select" required>
                    <option value="false" selected>Customer Login</option>
                    <option value="true">Courier Login</option>
                </select>
            </div>

            <div class="mb-4 form-check d-flex justify-content-center">
                <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember me</label>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary" id="loginButton">
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span class="button-text">Log in</span>
                </button>
            </div>

            <div class="text-center">
                <a asp-action="ForgotPassword" asp-controller="Account">Forgot your password?</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/dist/login.css" asp-append-version="true" />
    <script src="~/dist/login.js" asp-append-version="true"></script>
}
