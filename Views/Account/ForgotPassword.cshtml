@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    ViewBag.PageId = "login";
    var recaptchaSiteKey = Environment.GetEnvironmentVariable("GoogleRecaptchaSiteKey");
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h2>@ViewData["Title"]</h2>
        <p class="auth-subtitle">Enter your email to reset your password.</p>

        <div id="messageArea" class="alert d-none mb-3" role="alert"></div>

        <form asp-action="ForgotPassword" asp-controller="Account" id="forgot-password-form" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3 form-floating">
                <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email"
                       required autocomplete="email" />
                <label asp-for="Email">Email</label>
                <div class="invalid-feedback"></div>
            </div>

            <div class="mb-3">
                <input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response">
            </div>

            <div class="mb-3 text-center">
                <button type="submit" id="submitButton" class="btn btn-primary">
                    <dfrnt-icon set="lucide" name="key-round" />
                    <span class="button-label">Reset Password</span>
                </button>
            </div>
        </form>

        <div class="text-start">
            <a asp-action="Login" asp-controller="Account">Back to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <meta name="recaptcha-site-key" content="@recaptchaSiteKey" />
    <script src="https://www.google.com/recaptcha/api.js?render=@recaptchaSiteKey"></script>
    <script src="~/dist/forgot-password.js" asp-append-version="true"></script>
}
