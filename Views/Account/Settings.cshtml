@model List<TenantUserSettingViewModel>

<div class="settings-page">
    <h2>User Settings</h2>

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="card mb-4">
            <div class="card-header">
                <h3>API Key</h3>
            </div>
            <div class="card-body">
                @{
                    var apiKeyValue = Model.FirstOrDefault(x => x.Name == "APIKey")?.Value;
                    var hasApiKey = !string.IsNullOrEmpty(apiKeyValue);
                }
                <div class="mb-3 d-flex align-items-center gap-2">
                    <md-outlined-text-field id="ApiKey" name="ApiKey" label="API Key"
                                            value="@apiKeyValue" readonly style="flex:1">
                    </md-outlined-text-field>
                    <md-outlined-button type="button" id="generateApiKey" class="@(hasApiKey ? "d-none" : null)">
                        Generate Key
                    </md-outlined-button>
                    <md-outlined-button type="button" id="copyApiKey" title="Copy to clipboard"
                                        class="@(hasApiKey ? null : "d-none")">
                        <md-icon slot="icon">content_copy</md-icon>
                        Copy
                    </md-outlined-button>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Other Settings</h3>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>Setting</th>
                        <th>Value</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var setting in Model.Where(x => x.Name != "APIKey"))
                    {
                        <tr>
                            <td>@setting.Name</td>
                            <td>
                                <md-outlined-text-field name="OtherSettings[@setting.Name]" value="@setting.Value">
                                </md-outlined-text-field>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <md-filled-button type="submit">Save Settings</md-filled-button>
    </form>
</div>

@section Scripts {
    <script src="~/dist/settings.js" asp-append-version="true"></script>
}
