@model List<TenantUserSettingViewModel>

<div class="settings-page">
    <h2>User Settings</h2>

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="card mb-4">
            <div class="card-header">
                <h3>API Key</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="ApiKey">API Key</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="ApiKey" name="ApiKey"
                               value="@Model.FirstOrDefault(x => x.Name == "APIKey")?.Value" readonly/>
                        @if (string.IsNullOrEmpty(Model.FirstOrDefault(x => x.Name == "APIKey")?.Value))
                        {
                            <button type="button" class="btn btn-outline-secondary" id="generateApiKey">
                                Generate Key
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary" id="copyApiKey"
                                    title="Copy to clipboard">
                                <span class="material-symbols-outlined" style="font-size:18px;vertical-align:middle">content_copy</span>
                                Copy
                            </button>
                        }
                    </div>
                    <div class="invalid-feedback" id="apiKeyError"></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Other Settings</h3>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>Setting</th>
                        <th>Value</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var setting in Model.Where(x => x.Name != "APIKey"))
                    {
                        <tr>
                            <td>@setting.Name</td>
                            <td>
                                <input type="text" class="form-control" name="OtherSettings[@setting.Name]"
                                       value="@setting.Value"/>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save Settings</button>
    </form>
</div>

@section Scripts {
    <script src="~/dist/settings.js" asp-append-version="true"></script>
}
