@model List<TenantUserSettingViewModel>

<div class="settings-page">
    <h2>User Settings</h2>

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="card mb-4">
            <div class="card-header">
                <h3>API Key</h3>
            </div>
            <div class="card-body">
                @{
                    var apiKeyValue = Model.FirstOrDefault(x => x.Name == "APIKey")?.Value;
                    var hasApiKey = !string.IsNullOrEmpty(apiKeyValue);
                }
                <div class="mb-1 d-flex align-items-center gap-2">
                    <div class="form-floating flex-grow-1">
                        <input id="ApiKey" name="ApiKey" class="form-control" placeholder="API Key"
                               value="@apiKeyValue" readonly />
                        <label for="ApiKey">API Key</label>
                    </div>
                    <button type="button" class="btn btn-outline-secondary @(hasApiKey ? "d-none" : null)" id="generateApiKey">
                        Generate Key
                    </button>
                    <button type="button" class="btn btn-outline-secondary @(hasApiKey ? null : "d-none")"
                            id="copyApiKey" title="Copy to clipboard">
                        <dfrnt-icon set="lucide" name="copy" class="copy-icon-copy" />
                        <dfrnt-icon set="lucide" name="check" class="copy-icon-check d-none" />
                        <span class="copy-label">Copy</span>
                    </button>
                </div>
                <div class="invalid-feedback d-none" id="apiKeyError"></div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Other Settings</h3>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>Setting</th>
                        <th>Value</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var setting in Model.Where(x => x.Name != "APIKey"))
                    {
                        <tr>
                            <td>@setting.Name</td>
                            <td>
                                <input class="form-control" name="OtherSettings[@setting.Name]"
                                       value="@setting.Value" aria-label="@setting.Name" />
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save Settings</button>
    </form>
</div>

@section Scripts {
    <script src="~/dist/settings.js" asp-append-version="true"></script>
}
