<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <SpaRoot>ClientApp\</SpaRoot>
    <SpaProxyServerUrl>http://hub.local.deliverdifferent.com:5173/</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Hub.Tests\**" />
    <Content Remove="Hub.Tests\**" />
    <EmbeddedResource Remove="Hub.Tests\**" />
    <None Remove="Hub.Tests\**" />
    <Compile Remove="ClientApp\**" />
    <Content Remove="ClientApp\**" />
    <EmbeddedResource Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="efpt.Despatch.config.json.user" />
    <None Include="efpt.Master.config.json.user" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.AspNetCore.DataProtection.SSM" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="AWSSDK.Core" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>
  <!--
    The SPA in ClientApp builds into wwwroot. Docker and CI build it in their own node stage and pass
    -p:SkipSpaBuild=true; a local build does it here, and only when ClientApp sources changed.
  -->
  <ItemGroup>
    <SpaSource Include="$(SpaRoot)src\**;$(SpaRoot)public\**;$(SpaRoot)index.html;$(SpaRoot)vite.config.ts;$(SpaRoot)package-lock.json" />
  </ItemGroup>
  <Target Name="NpmInstall" BeforeTargets="NpmBuild" Condition="'$(SkipSpaBuild)' != 'true'"
          Inputs="$(SpaRoot)package-lock.json" Outputs="$(SpaRoot)node_modules\.install-stamp">
    <Exec Command="npm ci" WorkingDirectory="$(SpaRoot)" />
    <Touch Files="$(SpaRoot)node_modules\.install-stamp" AlwaysCreate="true" />
  </Target>
  <Target Name="NpmBuild" BeforeTargets="BeforeBuild" Condition="'$(SkipSpaBuild)' != 'true'"
          Inputs="@(SpaSource)" Outputs="wwwroot\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
  </Target>
</Project>
